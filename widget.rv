// quill's widget model: the retained tree, its builders and chained modifiers,
// and the queries the runtime runs over it (hit-testing, focus order, scroll
// geometry, input lookup). Layout lives in layout.rv and drawing in paint.rv, so
// the dependency runs one way (widget -> layout -> paint), since Raven forbids
// import cycles. Build a tree with the builders:
//
//     from "github.com/martian56/quill/widget" import column, row, label, button, input
//
//     column([label("count: ${m.count}").size(28), button("inc", "Add one")]).pad(24).gap(16)

from "./lib" import Color, Rect, Theme
import std.string
from std.collections import Map

// Slider handle radius, shared by the value query here and the painter. Raven
// folds consts per module, so layout.rv and paint.rv keep their own tuning
// constants rather than importing these.
let SLIDER_R: int = 9

// Cross-axis alignment of a container's children (align-items).
enum Align {
    Start,
    Center,
    End,
    Stretch,
}

// Main-axis distribution of a container's children (justify-content). Only
// applies when there is leftover space, so it is ignored once a child grows.
enum Justify {
    Start,
    Center,
    End,
    Between,
}

// What a node is. Containers carry children; leaves carry their content. Button
// and Input carry an id; Input also carries its current text.
enum WidgetKind {
    Column,
    Row,
    Panel,
    Scroll(str),
    Label(str),
    Button(str, str),
    Input(str, str),
    TextArea(str, str),
    Checkbox(str, bool, str),
    Radio(str, bool, str),
    Slider(str, int, int, int),
    Dropdown(str, str, list[str]),
    Image(int, int, int),
    Divider,
    Modal(str),
}

// One node of the UI tree. Style is set with the chained modifiers below; mw/mh
// and box are filled in by layout and read by paint.
class Widget {
    kind: WidgetKind
    kids: list[Widget]
    flex: int
    inset: int
    spacing: int
    fill: Color?
    corner: int
    wfix: int
    hfix: int
    tsize: int
    tint: Color?
    cross: Align
    main: Justify
    enabled: bool
    mw: int
    mh: int
    box: Rect
    scroll: int
    tip: str
}

fun _widget(kind: WidgetKind, kids: list[Widget]) -> Widget {
    return Widget(
        kind: kind,
        kids: kids,
        flex: 0,
        inset: 0,
        spacing: 0,
        fill: None,
        corner: 0,
        wfix: -1,
        hfix: -1,
        tsize: 16,
        tint: None,
        cross: Align.Stretch,
        main: Justify.Start,
        enabled: true,
        mw: 0,
        mh: 0,
        box: Rect(x: 0, y: 0, w: 0, h: 0),
        scroll: 0,
        tip: "",
    )
}

fun _leaf(kind: WidgetKind) -> Widget {
    let none: list[Widget] = []
    return _widget(kind, none)
}

fun column(kids: list[Widget]) -> Widget {
    return _widget(WidgetKind.Column, kids)
}

fun row(kids: list[Widget]) -> Widget {
    return _widget(WidgetKind.Row, kids)
}

fun panel(child: Widget) -> Widget {
    return _widget(WidgetKind.Panel, [child])
}

// A vertically scrollable viewport around child. Give it a bounded height (with
// grow or height); when the content is taller, the mouse wheel scrolls it. id
// keys its scroll position across frames.
fun scroll(id: str, child: Widget) -> Widget {
    return _widget(WidgetKind.Scroll(id), [child])
}

// Overlay dialog centered over base with a dimmed backdrop. The base is not
// clickable while the modal is open; clicking the backdrop sends
// Click(dismiss_id). Wrap your view in this only while the dialog is open.
fun modal(base: Widget, dialog: Widget, dismiss_id: str) -> Widget {
    return _widget(WidgetKind.Modal(dismiss_id), [base, dialog])
}

fun label(text: str) -> Widget {
    return _leaf(WidgetKind.Label(text))
}

fun button(id: str, text: str) -> Widget {
    return _leaf(WidgetKind.Button(id, text))
}

// A single-line text field. value is the current text (from the model); the
// framework edits it and sends UiEvent.Input(id, new_value).
fun input(id: str, value: str) -> Widget {
    return _leaf(WidgetKind.Input(id, value))
}

// A multi-line text area that wraps its text to the widget width. value is the
// current text (with embedded newlines); the framework edits it, keeps the caret
// visible, and sends UiEvent.Input(id, new_value). Give it a height (with height
// or grow) to set how many rows are visible; content past that scrolls.
fun textarea(id: str, value: str) -> Widget {
    return _leaf(WidgetKind.TextArea(id, value))
}

// A labelled checkbox. checked comes from the model; clicking it sends
// UiEvent.Click(id), so update flips the flag.
fun checkbox(id: str, checked: bool, text: str) -> Widget {
    return _leaf(WidgetKind.Checkbox(id, checked, text))
}

// A labelled radio button. selected comes from the model; clicking it sends
// UiEvent.Click(id), so update sets the group's value to id.
fun radio(id: str, selected: bool, text: str) -> Widget {
    return _leaf(WidgetKind.Radio(id, selected, text))
}

// A horizontal slider from lo to hi. value comes from the model; dragging the
// handle sends UiEvent.Slide(id, new_value).
fun slider(id: str, value: int, lo: int, hi: int) -> Widget {
    return _leaf(WidgetKind.Slider(id, value, lo, hi))
}

// A dropdown showing selected, opening a menu of options below it. Clicking the
// trigger opens it; picking an option sends UiEvent.Select(id, option).
fun dropdown(id: str, selected: str, options: list[str]) -> Widget {
    return _leaf(WidgetKind.Dropdown(id, selected, options))
}

// Draw a loaded image (Image.load(...).id) at w by h pixels.
fun image(handle: int, w: int, h: int) -> Widget {
    return _leaf(WidgetKind.Image(handle, w, h))
}

// A thin horizontal rule that stretches across its container.
fun divider() -> Widget {
    return _leaf(WidgetKind.Divider)
}

// A tab bar built from buttons: the active tab is filled with the accent, the
// rest are muted. Clicking a tab sends Click("<id>:<label>"), so update can set
// the active tab (see tab_of to read the label back).
fun tabs(id: str, active: str, labels: list[str], theme: Theme) -> Widget {
    let items: list[Widget] = []
    var i = 0
    while i < labels.len() {
        let lbl = labels[i]
        var b = button("${id}:${lbl}", lbl)
        if lbl == active {
            b = b.bg(theme.accent).color(theme.on_accent)
        } else {
            b = b.bg(theme.surface).color(theme.muted)
        }
        items.push(b)
        i = i + 1
    }
    return row(items).gap(4)
}

// The tab label from a "<id>:<label>" click id, for use in update.
fun tab_of(click_id: str) -> str {
    let n = click_id.index_of(":")
    if n < 0 {
        return ""
    }
    return click_id.substring(n + 1, click_id.length())
}

// Chained modifiers. Each mutates and returns the node, so they compose:
// column([...]).pad(24).gap(16).bg(theme.surface).rounded(16).
impl Widget {
    fun grow(self, weight: int) -> Widget {
        self.flex = weight
        return self
    }

    fun pad(self, n: int) -> Widget {
        self.inset = n
        return self
    }

    fun gap(self, n: int) -> Widget {
        self.spacing = n
        return self
    }

    fun bg(self, c: Color) -> Widget {
        self.fill = Some(c)
        return self
    }

    fun rounded(self, r: int) -> Widget {
        self.corner = r
        return self
    }

    fun width(self, n: int) -> Widget {
        self.wfix = n
        return self
    }

    fun height(self, n: int) -> Widget {
        self.hfix = n
        return self
    }

    fun size(self, n: int) -> Widget {
        self.tsize = n
        return self
    }

    fun color(self, c: Color) -> Widget {
        self.tint = Some(c)
        return self
    }

    // Cross-axis alignment of this container's children.
    fun align(self, a: Align) -> Widget {
        self.cross = a
        return self
    }

    // Main-axis distribution of this container's children.
    fun justify(self, j: Justify) -> Widget {
        self.main = j
        return self
    }

    // Grey this control out and stop it responding to clicks.
    fun disabled(self) -> Widget {
        self.enabled = false
        return self
    }

    // Show this text in a small popup after the cursor rests on the widget.
    fun tip(self, text: str) -> Widget {
        self.tip = text
        return self
    }
}

fun _contains(r: Rect, x: int, y: int) -> bool {
    return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h
}

// A hit-tested target: an interactive widget's id, whether it is a text input,
// and whether it is dragged (a slider) rather than clicked.
class Hit {
    id: str
    input: bool
    drag: bool
}

// The topmost interactive widget under (x, y), if any.
fun _hit(w: Widget, x: int, y: int) -> Hit? {
    // A modal hit-tests its dialog, then swallows any other click as a dismiss,
    // so the base underneath is never reached. A scroll viewport clips
    // hit-testing to its box, so off-screen children are not clickable.
    match w.kind {
        case Modal(id) {
            return _hit_modal(w, id, x, y)
        }
        case Scroll(id) {
            if not _contains(w.box, x, y) {
                return None
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _hit(w.kids[i], x, y) {
            case Some(h) {
                return Some(h)
            }
            case None {}
        }
        i = i + 1
    }
    if not w.enabled {
        return None
    }
    match w.kind {
        case Button(id, text) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: false, drag: false))
            }
        }
        case Input(id, value) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: true, drag: false))
            }
        }
        case TextArea(id, value) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: true, drag: false))
            }
        }
        case Checkbox(id, checked, text) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: false, drag: false))
            }
        }
        case Radio(id, selected, text) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: false, drag: false))
            }
        }
        case Slider(id, value, lo, hi) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: false, drag: true))
            }
        }
        case Dropdown(id, selected, options) {
            if _contains(w.box, x, y) {
                return Some(Hit(id: id, input: false, drag: false))
            }
        }
        case _ {}
    }
    return None
}

// The deepest widget carrying a tooltip under (x, y), if any. Scroll viewports
// clip the search to their box so a scrolled-out widget shows no tip.
fun _tip_at(w: Widget, x: int, y: int) -> Widget? {
    match w.kind {
        case Scroll(id) {
            if not _contains(w.box, x, y) {
                return None
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _tip_at(w.kids[i], x, y) {
            case Some(t) {
                return Some(t)
            }
            case None {}
        }
        i = i + 1
    }
    if w.tip != "" and _contains(w.box, x, y) {
        return Some(w)
    }
    return None
}

// The dropdown widget with this id, if present (carries its box and options).
fun _find_dropdown(w: Widget, id: str) -> Widget? {
    match w.kind {
        case Dropdown(did, selected, options) {
            if did == id {
                return Some(w)
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _find_dropdown(w.kids[i], id) {
            case Some(d) {
                return Some(d)
            }
            case None {}
        }
        i = i + 1
    }
    return None
}

// The nth option of a dropdown widget.
fun _dd_option(w: Widget, i: int) -> str {
    return match w.kind {
        case Dropdown(id, selected, options) { options[i] }
        case _ { "" }
    }
}

fun _dd_count(w: Widget) -> int {
    return match w.kind {
        case Dropdown(id, selected, options) { options.len() }
        case _ { 0 }
    }
}

fun _hit_modal(w: Widget, id: str, x: int, y: int) -> Hit? {
    if w.kids.len() >= 2 {
        match _hit(w.kids[1], x, y) {
            case Some(h) {
                return Some(h)
            }
            case None {}
        }
    }
    if _contains(w.box, x, y) {
        return Some(Hit(id: id, input: false, drag: false))
    }
    return None
}

// Inject each scroll container's saved offset before layout.
fun _apply_scroll(w: Widget, offsets: dict[str, int]) {
    match w.kind {
        case Scroll(id) {
            w.scroll = offsets.get_or(id, 0)
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        _apply_scroll(w.kids[i], offsets)
        i = i + 1
    }
    return
}

// The innermost scroll container under (x, y), if any.
fun _scroll_at(w: Widget, x: int, y: int) -> Widget? {
    var i = 0
    while i < w.kids.len() {
        match _scroll_at(w.kids[i], x, y) {
            case Some(s) {
                return Some(s)
            }
            case None {}
        }
        i = i + 1
    }
    match w.kind {
        case Scroll(id) {
            if _contains(w.box, x, y) {
                return Some(w)
            }
        }
        case _ {}
    }
    return None
}

fun _scroll_id(w: Widget) -> str {
    return match w.kind {
        case Scroll(id) { id }
        case _ { "" }
    }
}

// The scrollable overshoot (content height beyond the viewport) of a scroll box.
fun _scroll_extent(w: Widget) -> int {
    if w.kids.len() == 0 {
        return 0
    }
    let max_off = w.kids[0].mh - w.box.h
    if max_off < 0 {
        return 0
    }
    return max_off
}

// Every input id in tree (tab) order.
fun _focusables(w: Widget) -> list[str] {
    let out: list[str] = []
    _collect_focusables(w, out)
    return out
}

fun _collect_focusables(w: Widget, out: list[str]) {
    match w.kind {
        case Input(id, value) { out.push(id) }
        case TextArea(id, value) { out.push(id) }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        _collect_focusables(w.kids[i], out)
        i = i + 1
    }
    return
}

// The input to focus after current when Tab is pressed, wrapping around; the
// first input when nothing is focused, or None when there are no inputs.
fun _next_focus(w: Widget, current: str?) -> str? {
    let ids = _focusables(w)
    if ids.len() == 0 {
        return None
    }
    match current {
        case Some(cur) {
            var i = 0
            while i < ids.len() {
                if ids[i] == cur {
                    return Some(ids[(i + 1) % ids.len()])
                }
                i = i + 1
            }
            return Some(ids[0])
        }
        case None {
            return Some(ids[0])
        }
    }
    return None
}

// The slider value for a cursor x, if the slider with this id is in the tree.
fun _slider_value_at(w: Widget, id: str, x: int) -> int? {
    match w.kind {
        case Slider(sid, value, lo, hi) {
            if sid == id {
                let usable = w.box.w - 2 * SLIDER_R
                if usable <= 0 {
                    return Some(lo)
                }
                var rel = x - w.box.x - SLIDER_R
                if rel < 0 {
                    rel = 0
                }
                if rel > usable {
                    rel = usable
                }
                return Some(lo + (rel * (hi - lo) + usable / 2) / usable)
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _slider_value_at(w.kids[i], id, x) {
            case Some(v) {
                return Some(v)
            }
            case None {}
        }
        i = i + 1
    }
    return None
}

// The input or text area with this id, if present (carries its box and value for
// focus, click-to-caret, and editing).
fun _find_input(w: Widget, id: str) -> Widget? {
    match w.kind {
        case Input(iid, value) {
            if iid == id {
                return Some(w)
            }
        }
        case TextArea(iid, value) {
            if iid == id {
                return Some(w)
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _find_input(w.kids[i], id) {
            case Some(inp) {
                return Some(inp)
            }
            case None {}
        }
        i = i + 1
    }
    return None
}

// The current text of the input or text area with this id, if present.
fun _find_input_value(w: Widget, id: str) -> str? {
    match w.kind {
        case Input(iid, value) {
            if iid == id {
                return Some(value)
            }
        }
        case TextArea(iid, value) {
            if iid == id {
                return Some(value)
            }
        }
        case _ {}
    }
    var i = 0
    while i < w.kids.len() {
        match _find_input_value(w.kids[i], id) {
            case Some(v) {
                return Some(v)
            }
            case None {}
        }
        i = i + 1
    }
    return None
}

// Drop the last UTF-8 character, skipping continuation bytes so multi-byte
// characters are removed whole.
fun _drop_last(s: str) -> str {
    let n = s.length()
    if n == 0 {
        return s
    }
    var cut = n - 1
    var scanning = true
    while scanning {
        if cut == 0 {
            scanning = false
        } else {
            let b = s.byte_at(cut)
            if b >= 128 and b < 192 {
                cut = cut - 1
            } else {
                scanning = false
            }
        }
    }
    return s.substring(0, cut)
}
