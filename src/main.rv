// Demo launcher. Run with: rvpm run -- [showcase|hello]
from std.env import args
from std.io import println
from "../examples/showcase" import showcase_main
from "../examples/hello" import hello_main

fun main() {
    let a = args()
    var pick = "showcase"
    var i = 0
    while i < a.len() {
        if a[i] == "hello" {
            pick = "hello"
        }
        i = i + 1
    }
    var ok = true
    if pick == "hello" {
        ok = hello_main()
    } else {
        ok = showcase_main()
    }
    if not ok {
        println("quill could not open a window; run this on a desktop session")
    }
}
