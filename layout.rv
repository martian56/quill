// quill layout: the flex measure and arrange passes over a widget tree. measure
// fills each node's desired size (mw, mh) bottom up; arrange places each node in
// a box, honoring grow, alignment, and scroll offsets.

from "./lib" import Theme, Rect
from "./widget" import Widget, WidgetKind, Align, Justify

let BUTTON_PAD_X: int = 16
let BUTTON_PAD_Y: int = 9
let INPUT_PAD_X: int = 12
let INPUT_PAD_Y: int = 9
let INPUT_MIN_W: int = 160
let CHECK_GAP: int = 10
let SLIDER_W: int = 200
let SLIDER_H: int = 24
let DD_PAD_X: int = 12
let DD_PAD_Y: int = 8
let DD_ARROW: int = 22
let TA_PAD: int = 10
let TA_ROWS: int = 5

// Fill each child's desired size (mw, mh), bottom up.
fun measure(w: Widget, theme: Theme) {
    match w.kind {
        case Label(text) {
            w.mw = theme.font.width(w.tsize, text)
            w.mh = theme.font.line_height(w.tsize)
        }
        case Button(id, text) {
            w.mw = theme.font.width(w.tsize, text) + 2 * BUTTON_PAD_X
            w.mh = theme.font.line_height(w.tsize) + 2 * BUTTON_PAD_Y
        }
        case Input(id, value) {
            let content = theme.font.width(w.tsize, value) + 2 * INPUT_PAD_X + 24
            w.mw = content
            if content < INPUT_MIN_W {
                w.mw = INPUT_MIN_W
            }
            w.mh = theme.font.line_height(w.tsize) + 2 * INPUT_PAD_Y
        }
        case TextArea(id, value) {
            w.mw = INPUT_MIN_W
            w.mh = TA_ROWS * theme.font.line_height(w.tsize) + 2 * TA_PAD
        }
        case Checkbox(id, checked, text) {
            let box = theme.font.line_height(w.tsize)
            w.mw = box + CHECK_GAP + theme.font.width(w.tsize, text)
            w.mh = box
        }
        case Radio(id, selected, text) {
            let box = theme.font.line_height(w.tsize)
            w.mw = box + CHECK_GAP + theme.font.width(w.tsize, text)
            w.mh = box
        }
        case Slider(id, value, lo, hi) {
            w.mw = SLIDER_W
            w.mh = SLIDER_H
        }
        case Dropdown(id, selected, options) {
            var maxw = theme.font.width(w.tsize, selected)
            var i = 0
            while i < options.len() {
                let ow = theme.font.width(w.tsize, options[i])
                if ow > maxw {
                    maxw = ow
                }
                i = i + 1
            }
            w.mw = maxw + 2 * DD_PAD_X + DD_ARROW
            w.mh = theme.font.line_height(w.tsize) + 2 * DD_PAD_Y
        }
        case Image(handle, iw, ih) {
            w.mw = iw
            w.mh = ih
        }
        case Divider {
            w.mw = 0
            w.mh = 1
        }
        case Column {
            var total = 0
            var cross = 0
            var i = 0
            while i < w.kids.len() {
                let kid = w.kids[i]
                measure(kid, theme)
                total = total + kid.mh
                if kid.mw > cross {
                    cross = kid.mw
                }
                i = i + 1
            }
            total = total + _gaps(w.spacing, w.kids.len())
            w.mw = cross + 2 * w.inset
            w.mh = total + 2 * w.inset
        }
        case Row {
            var total = 0
            var cross = 0
            var i = 0
            while i < w.kids.len() {
                let kid = w.kids[i]
                measure(kid, theme)
                total = total + kid.mw
                if kid.mh > cross {
                    cross = kid.mh
                }
                i = i + 1
            }
            total = total + _gaps(w.spacing, w.kids.len())
            w.mw = total + 2 * w.inset
            w.mh = cross + 2 * w.inset
        }
        case Panel {
            var cw = 0
            var ch = 0
            if w.kids.len() > 0 {
                let child = w.kids[0]
                measure(child, theme)
                cw = child.mw
                ch = child.mh
            }
            w.mw = cw + 2 * w.inset
            w.mh = ch + 2 * w.inset
        }
        case Scroll(id) {
            if w.kids.len() > 0 {
                let child = w.kids[0]
                measure(child, theme)
                w.mw = child.mw
                w.mh = child.mh
            }
        }
        case Modal(id) {
            if w.kids.len() >= 2 {
                measure(w.kids[0], theme)
                measure(w.kids[1], theme)
                w.mw = w.kids[0].mw
                w.mh = w.kids[0].mh
            }
        }
    }
    if w.wfix >= 0 {
        w.mw = w.wfix
    }
    if w.hfix >= 0 {
        w.mh = w.hfix
    }
    return
}

fun _gaps(spacing: int, n: int) -> int {
    if n > 1 {
        return spacing * (n - 1)
    }
    return 0
}

// Place w into box, then recurse into children.
fun arrange(w: Widget, box: Rect) {
    w.box = box
    match w.kind {
        case Column { _arrange_column(w, box.inset(w.inset)) }
        case Row { _arrange_row(w, box.inset(w.inset)) }
        case Panel {
            if w.kids.len() > 0 {
                arrange(w.kids[0], box.inset(w.inset))
            }
        }
        case Scroll(id) {
            if w.kids.len() > 0 {
                let child = w.kids[0]
                var max_off = child.mh - box.h
                if max_off < 0 {
                    max_off = 0
                }
                var off = w.scroll
                if off < 0 {
                    off = 0
                }
                if off > max_off {
                    off = max_off
                }
                w.scroll = off
                arrange(child, Rect(x: box.x, y: box.y - off, w: box.w, h: child.mh))
            }
        }
        case Modal(id) {
            if w.kids.len() >= 2 {
                arrange(w.kids[0], box)
                let dialog = w.kids[1]
                let dw = dialog.mw
                let dh = dialog.mh
                let dx = box.x + (box.w - dw) / 2
                let dy = box.y + (box.h - dh) / 2
                arrange(dialog, Rect(x: dx, y: dy, w: dw, h: dh))
            }
        }
        case _ {}
    }
    return
}

fun _arrange_column(w: Widget, inner: Rect) {
    let n = w.kids.len()
    var content = 0
    var flex_total = 0
    var i = 0
    while i < n {
        let kid = w.kids[i]
        if kid.flex == 0 {
            content = content + kid.mh
        } else {
            flex_total = flex_total + kid.flex
        }
        i = i + 1
    }
    content = content + _gaps(w.spacing, n)
    var leftover = inner.h - content
    if leftover < 0 {
        leftover = 0
    }
    var cursor = inner.y + _main_offset(w.main, leftover, flex_total)
    let extra = _main_extra_gap(w.main, leftover, flex_total, n)
    i = 0
    while i < n {
        let kid = w.kids[i]
        var kh = kid.mh
        if kid.flex > 0 {
            kh = _share(leftover, kid.flex, flex_total)
        }
        let kw = _cross_size(w.cross, kid.wfix, kid.mw, inner.w)
        let kx = inner.x + _cross_offset(w.cross, kw, inner.w)
        arrange(kid, Rect(x: kx, y: cursor, w: kw, h: kh))
        cursor = cursor + kh + w.spacing + extra
        i = i + 1
    }
    return
}

fun _arrange_row(w: Widget, inner: Rect) {
    let n = w.kids.len()
    var content = 0
    var flex_total = 0
    var i = 0
    while i < n {
        let kid = w.kids[i]
        if kid.flex == 0 {
            content = content + kid.mw
        } else {
            flex_total = flex_total + kid.flex
        }
        i = i + 1
    }
    content = content + _gaps(w.spacing, n)
    var leftover = inner.w - content
    if leftover < 0 {
        leftover = 0
    }
    var cursor = inner.x + _main_offset(w.main, leftover, flex_total)
    let extra = _main_extra_gap(w.main, leftover, flex_total, n)
    i = 0
    while i < n {
        let kid = w.kids[i]
        var kw = kid.mw
        if kid.flex > 0 {
            kw = _share(leftover, kid.flex, flex_total)
        }
        let kh = _cross_size(w.cross, kid.hfix, kid.mh, inner.h)
        let ky = inner.y + _cross_offset(w.cross, kh, inner.h)
        arrange(kid, Rect(x: cursor, y: ky, w: kw, h: kh))
        cursor = cursor + kw + w.spacing + extra
        i = i + 1
    }
    return
}

fun _share(leftover: int, weight: int, total: int) -> int {
    if total > 0 {
        return leftover * weight / total
    }
    return 0
}

// Where the packed block of children starts along the main axis.
fun _main_offset(j: Justify, leftover: int, flex_total: int) -> int {
    if flex_total > 0 {
        return 0
    }
    match j {
        case Center {
            return leftover / 2
        }
        case End {
            return leftover
        }
        case _ {}
    }
    return 0
}

// Extra spacing added between children for space-between.
fun _main_extra_gap(j: Justify, leftover: int, flex_total: int, n: int) -> int {
    if flex_total > 0 {
        return 0
    }
    match j {
        case Between {
            if n > 1 {
                return leftover / (n - 1)
            }
        }
        case _ {}
    }
    return 0
}

// A child's size on the cross axis: a fixed size wins, else stretch fills the
// container and any other alignment uses the measured size.
fun _cross_size(a: Align, fix: int, measured: int, inner_cross: int) -> int {
    if fix >= 0 {
        return fix
    }
    match a {
        case Stretch {
            return inner_cross
        }
        case _ {}
    }
    return measured
}

// A child's offset on the cross axis for its alignment.
fun _cross_offset(a: Align, size: int, inner_cross: int) -> int {
    match a {
        case Center {
            return (inner_cross - size) / 2
        }
        case End {
            return inner_cross - size
        }
        case _ {}
    }
    return 0
}
